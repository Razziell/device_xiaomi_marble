+    /** Optional device-specific correction loaded from SYSTEMSERVERCLASSPATH. */
+    private final DoubleUnaryOperator mAlsCorrection = loadAlsCorrection();
+    private boolean mAlsCorrectionFailureLogged;
+
+    /** Optional Consumer<Boolean> contract: reset correction state on ALS lifecycle transitions. */
+    @SuppressWarnings("unchecked")
+    private void notifyAlsCorrectionLightSensorEnabled(boolean enabled) {
+        if (mAlsCorrection instanceof Consumer<?>) {
+            try {
+                ((Consumer<Boolean>) mAlsCorrection).accept(enabled);
+            } catch (RuntimeException | LinkageError e) {
+                logAlsCorrectionFailure(e);
+            }
+        }
+    }
+
+    private float correctAmbientLux(float rawLux) {
+        try {
+            final float correctedLux = (float) mAlsCorrection.applyAsDouble(rawLux);
+            if (Float.isFinite(correctedLux) && correctedLux >= 0f) {
+                return correctedLux;
+            }
+        } catch (RuntimeException | LinkageError e) {
+            logAlsCorrectionFailure(e);
+        }
+        return rawLux;
+    }
+
+    private void logAlsCorrectionFailure(Throwable error) {
+        if (!mAlsCorrectionFailureLogged) {
+            mAlsCorrectionFailureLogged = true;
+            Slog.w(TAG, "ALS correction failed, using unmodified lux", error);
+        }
+    }
+
+    private static DoubleUnaryOperator loadAlsCorrection() {
+        final String className = SystemProperties.get(
+                "ro.vendor.display.als_correction_class");
+        if (className.isEmpty()) {
+            return value -> value;
+        }
+
+        try {
+            final Class<?> clazz = Class.forName(className);
+            final DoubleUnaryOperator correction = (DoubleUnaryOperator)
+                    clazz.getDeclaredConstructor().newInstance();
+            Slog.i(TAG, "Loaded ALS correction: " + className);
+            return correction;
+        } catch (ReflectiveOperationException | ClassCastException | LinkageError e) {
+            Slog.e(TAG, "Unable to load ALS correction: " + className, e);
+            return value -> value;
+        }
+    }
+
