+package com.android.server.display;
+
+import android.annotation.Nullable;
+import android.os.SystemProperties;
+import android.util.Slog;
+
+import com.android.internal.annotations.GuardedBy;
+
+import java.util.ArrayList;
+import java.util.function.Consumer;
+import java.util.function.DoubleUnaryOperator;
+
+/**
+ * Optional device-specific correction of ambient light sensor readings, for example to remove
+ * the light of the panel itself from the readings of an under-display sensor.
+ *
+ * <p>The implementation is the class named by {@code ro.vendor.display.als_correction_class},
+ * loaded from SYSTEMSERVERCLASSPATH. system_server creates one instance and every user of the
+ * light sensor shares it through its own {@link AmbientLightCorrection} client. The
+ * implementation has to be a {@link DoubleUnaryOperator} that maps raw lux to corrected lux on
+ * any thread, and may opt into two more contracts:
+ * <ul>
+ * <li>{@code Consumer<Boolean>}: called with {@code true} before the first client that needs the
+ * correction starts listening to the light sensor, and with {@code false} once the last one has
+ * stopped.
+ * <li>A public constructor taking a {@link Runnable}. The implementation may run it from any
+ * thread when its answer for the latest raw reading has changed; every listening client then
+ * corrects its latest raw reading again. It must not run it from inside its own methods or
+ * while holding a lock that they take.
+ * </ul>
+ * Without the property, readings pass through unchanged.
+ */
+public final class AmbientLightCorrection {
+    private static final String TAG = "AmbientLightCorrection";
+    private static final String PROP_CLASS = "ro.vendor.display.als_correction_class";
+
+    private static final Object sLock = new Object();
+    @GuardedBy("sLock")
+    private static final ArrayList<AmbientLightCorrection> sListening = new ArrayList<>();
+    @GuardedBy("sLock")
+    private static int sRequiredCount;
+    private static volatile boolean sFailureLogged;
+
+    /** Creates the shared implementation when the first client is constructed. */
+    private static final class Holder {
+        @Nullable
+        static final DoubleUnaryOperator CORRECTION = load();
+    }
+
+    @Nullable
+    private final DoubleUnaryOperator mCorrection = Holder.CORRECTION;
+    @Nullable
+    private final Runnable mOnReevaluate;
+    private final boolean mRequired;
+    @GuardedBy("sLock")
+    private boolean mListening;
+
+    /**
+     * @param onReevaluate run on an arbitrary thread when the latest raw reading of this client
+     *                     should go through {@link #correct} again; only while it is listening
+     * @param required whether the correction has to run for this client. A client that passes
+     *                 {@code false} gets corrected readings only while a required client keeps
+     *                 the correction running, and raw readings otherwise.
+     */
+    public AmbientLightCorrection(@Nullable Runnable onReevaluate, boolean required) {
+        mOnReevaluate = onReevaluate;
+        mRequired = required;
+    }
+
+    /** Call before registering and when unregistering the light sensor listener. */
+    public void setListening(boolean listening) {
+        synchronized (sLock) {
+            if (mListening == listening) {
+                return;
+            }
+            mListening = listening;
+            if (listening) {
+                sListening.add(this);
+            } else {
+                sListening.remove(this);
+            }
+            if (mRequired) {
+                sRequiredCount += listening ? 1 : -1;
+                if (sRequiredCount == (listening ? 1 : 0)) {
+                    notifyRunning(listening);
+                }
+            }
+        }
+    }
+
+    /** Returns the corrected reading, or {@code rawLux} if there is nothing to correct it with. */
+    public float correct(float rawLux) {
+        if (mCorrection == null || !Float.isFinite(rawLux) || rawLux < 0f) {
+            return rawLux;
+        }
+        try {
+            final float correctedLux = (float) mCorrection.applyAsDouble(rawLux);
+            if (Float.isFinite(correctedLux) && correctedLux >= 0f) {
+                return correctedLux;
+            }
+        } catch (RuntimeException | LinkageError e) {
+            logFailure(e);
+        }
+        return rawLux;
+    }
+
+    @Override
+    public String toString() {
+        return mCorrection == null ? "none" : mCorrection.toString();
+    }
+
+    @SuppressWarnings("unchecked")
+    @GuardedBy("sLock")
+    private void notifyRunning(boolean running) {
+        if (mCorrection instanceof Consumer<?>) {
+            try {
+                ((Consumer<Boolean>) mCorrection).accept(running);
+            } catch (RuntimeException | LinkageError e) {
+                logFailure(e);
+            }
+        }
+    }
+
+    /** Handed to the implementation; see the constructor contract in the class comment. */
+    private static void reevaluateAll() {
+        final AmbientLightCorrection[] clients;
+        synchronized (sLock) {
+            clients = sListening.toArray(new AmbientLightCorrection[0]);
+        }
+        for (AmbientLightCorrection client : clients) {
+            if (client.mOnReevaluate != null) {
+                client.mOnReevaluate.run();
+            }
+        }
+    }
+
+    private static void logFailure(Throwable error) {
+        if (!sFailureLogged) {
+            sFailureLogged = true;
+            Slog.w(TAG, "ALS correction failed, using unmodified lux", error);
+        }
+    }
+
+    @Nullable
+    private static DoubleUnaryOperator load() {
+        final String className = SystemProperties.get(PROP_CLASS);
+        if (className.isEmpty()) {
+            return null;
+        }
+
+        try {
+            final Class<?> clazz = Class.forName(className);
+            Object correction;
+            try {
+                final Runnable reevaluate = AmbientLightCorrection::reevaluateAll;
+                correction = clazz.getConstructor(Runnable.class).newInstance(reevaluate);
+            } catch (NoSuchMethodException e) {
+                correction = clazz.getDeclaredConstructor().newInstance();
+            }
+            Slog.i(TAG, "Loaded ALS correction: " + className);
+            return (DoubleUnaryOperator) correction;
+        } catch (ReflectiveOperationException | ClassCastException | LinkageError e) {
+            Slog.e(TAG, "Unable to load ALS correction: " + className, e);
+            return null;
+        }
+    }
+}
